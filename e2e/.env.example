# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.
# .env dosyası .gitignore'dadır, gerçek şifreyi asla commit etmeyin.

BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173/api

ADMIN_USERNAME=admin
# Kendi test hesabınızın şifresini yazın; buraya gerçek şifre yazmayın.
ADMIN_PASSWORD=

# Varsayılan olarak kapalı. "1" yapılırsa, gerçek iş gününü fiilen sonlandıran
# (EndBusinessDay) yıkıcı/geri alınamaz testler de çalışır. Paylaşımlı/canlı bir
# ortamda dikkatli kullanın — yalnızca test amaçlı, boş bir günde çalıştırın.
RUN_DESTRUCTIVE_TESTS=0

# Test hesabının TOTP (Google Authenticator) base32 sırrı; girişte kod buradan üretilir.
# Hesaba TOTP bir kez normal akışla (setup-init/setup-confirm) kurulup sır buraya yazılır.
E2E_TOTP_SECRET=

# Playwright taray�c� kanal� (bo� = indirilen chromium). Chromium a��lm�yorsa "msedge" veya "chrome".
PW_CHANNEL=
