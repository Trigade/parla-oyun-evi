# Üretim ortamı ayarları (docker-compose.prod.yml).
# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyasını ASLA paylaşmayın.

# --- Erişim adresi ---
# İnternete açık kurulum: alan adınızı yazın, HTTPS sertifikası otomatik alınır
# (alan adının DNS kaydı bu sunucuyu göstermeli, 80 ve 443 portları açık olmalı).
#   SITE_ADDRESS=parla.ornekalanadi.com
# Sadece yerel ağ (kasa bilgisayarı + aynı ağdaki tablet/telefon), düz HTTP:
#   SITE_ADDRESS=:80
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- Veritabanı ---
# Şifrede yalnızca harf ve rakam kullanın (bağlantı adresinin içine yazılıyor).
POSTGRES_USER=parla
POSTGRES_DB=parla_oyun_evi
POSTGRES_PASSWORD=

# --- Kimlik doğrulama ---
# En az 32 karakter, rastgele. Değiştirilirse tüm kullanıcıların oturumu kapanır.
JWT_SECRET=

# --- Otomatik yedek (./backups/prod klasörüne) ---
# SSDD formatında, Türkiye saati.
BACKUP_TIME=0300
BACKUP_KEEP_DAYS=30

# (Opsiyonel) Frontend'i başka bir adresten çağıracak origin'ler, virgülle ayrılmış.
# Normal kurulumda boş kalır: frontend ve API aynı adresten sunulur.
CORS_ALLOWED_ORIGINS=
